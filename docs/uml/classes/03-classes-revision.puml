@startuml

skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 0
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #000000
skinparam ArrowThickness 0.75
skinparam ArrowFontSize 10
skinparam titleFontSize 14
skinparam titleFontStyle bold
skinparam nodesep 25
skinparam ranksep 60
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

hide circle

title TsimokaAI - Revision (niveau conception)


package "Revision" {
  class Fiche {
    titre : String
    contenu : String
  }
  class Validation {
    statut : StatutValidation
    commentaire : String
  }
  enum StatutValidation <<enumeration>> {
    EN_ATTENTE
    VALIDEE
    REJETEE
  }
  class Annotation {
    contenu : String
  }
  class Partage {
  }
  class Quiz {
    titre : String
    portee : String
    difficulte : String
    statut : StatutQuiz
  }
  enum StatutQuiz <<enumeration>> {
    BROUILLON
    PUBLIE
  }
  class Tentative {
    score : Integer
  }
  class Correction {
    commentaire : String
    scoreCorrige : Integer
  }

  Fiche "1" --> "0..1" Validation : est validee par
  Fiche "1" *-- "*" Annotation : recoit
  Fiche "1" --> "*" Partage : est partagee via
  Quiz "1" --> "*" Partage : est partage via
  Quiz "0..*" --> "0..1" Fiche : issu de
  Quiz "1" *-- "*" Tentative : donne lieu a
  Tentative "1" --> "0..*" Correction : est corrigee par
}


' Rappels externes (hors package, sans package externe affiche)
class Groupe {
  nom : String
  description : String
}
class Utilisateur {
  email : String
  nomAffiche : String
}

Partage "0..1" --> Groupe : vers un groupe
Partage "0..1" --> Utilisateur : vers un destinataire


legend bottom
  Planche 3/4
endlegend


@enduml
