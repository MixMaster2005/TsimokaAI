@startuml

skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 0
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #000000
skinparam ArrowThickness 0.75
skinparam ArrowFontSize 10
skinparam titleFontSize 14
skinparam titleFontStyle bold
skinparam nodesep 25
skinparam ranksep 60
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

hide circle

title TsimokaAI - Contenu et assistant (niveau conception)


package "Contenu et assistant" {
  class Document {
    nom : String
    type : String
    statut : StatutDocument
  }
  enum StatutDocument <<enumeration>> {
    EN_PREPARATION
    EN_TRAITEMENT
    PRET
    EN_ECHEC
  }
  class Conversation {
    titre : String
  }
  class Message {
    contenu : String
    role : RoleMessage
  }
  enum RoleMessage <<enumeration>> {
    UTILISATEUR
    ASSISTANT
  }

  Conversation "1" *-- "*" Message : contient
}


' Rappels externes (hors package, sans package externe affiche)
class Espace {
  nom : String
  description : String
  matiere : String
  codeInvitation : String
  persona : String
}
class Utilisateur {
  email : String
  nomAffiche : String
  role : Role
}
enum Role <<enumeration>> {
  ETUDIANT
  ENSEIGNANT
}

Espace "1" *-- "*" Document : contient
Conversation --> Espace : porte sur
Conversation --> Utilisateur : appartient a


legend bottom
  Planche 2/4
endlegend


@enduml
