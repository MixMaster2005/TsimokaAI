@startuml

skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 0
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #000000
skinparam ArrowThickness 0.75
skinparam ArrowFontSize 10
skinparam titleFontSize 14
skinparam titleFontStyle bold
skinparam nodesep 25
skinparam ranksep 60
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

hide circle

title TsimokaAI - Comptes et espaces (niveau conception)


package "Comptes et espaces" {
  class Utilisateur {
    email : String
    nomAffiche : String
    role : Role
  }
  enum Role <<enumeration>> {
    ETUDIANT
    ENSEIGNANT
  }
  class Espace {
    nom : String
    description : String
    matiere : String
    codeInvitation : String
    persona : String
  }
  class Groupe {
    nom : String
    description : String
  }

  Utilisateur "1" --> "*" Espace : possede
  Utilisateur "*" --> "*" Espace : est membre de
  Espace "1" *-- "*" Groupe : contient
  Groupe "*" --> "*" Utilisateur : rassemble
}


legend bottom
  Planche 1/4
endlegend


@enduml
