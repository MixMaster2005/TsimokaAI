# Copier ce fichier en ".env" à la racine du repo avant `docker compose up`.
# NE JAMAIS committer le ".env" réel (secrets) — seul .env.example doit être versionné.

# --- PostgreSQL (instance unique, une base par service — voir infra/postgres-init) ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT (DOIT être identique entre api-gateway et user-service) ---
# Générer une valeur forte en production, ex: openssl rand -base64 48
JWT_SECRET=changeme-dev-secret-please-override-in-env-file-min-32-chars
JWT_ACCESS_TTL_SECONDS=900

# --- MinIO (stockage des fichiers uploadés) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# --- Bascule du provider LLM actif : groq | gemini | ollama ---
ACTIVE_LLM_PROVIDER=ollama

# --- Groq (API compatible OpenAI, cf. chat-service/application.yml) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini AI Studio (intégration à finaliser, cf. TODO chat-service/LlmProviderConfig) ---
GEMINI_API_KEY=

# --- Ollama (fallback local/hors-ligne — profil docker compose "ollama") ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
