# Copier ce fichier en ".env" à la racine du repo avant `docker compose up`.
# NE JAMAIS committer le ".env" réel (secrets) — seul .env.example doit être versionné.

# --- PostgreSQL (instance unique, une base par service — voir infra/postgres-init) ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT (DOIT être identique entre api-gateway et user-service) ---
# Générer une valeur forte en production, ex: openssl rand -base64 48
JWT_SECRET=changeme-dev-secret-please-override-in-env-file-min-32-chars
JWT_ACCESS_TTL_SECONDS=900

# --- MinIO (stockage des fichiers uploadés) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# --- Qdrant (base vectorielle multi-tenant) ---
# Option A : UNE seule collection partagée, chaque point porte son space_id en payload
# (filtre au retrieval). Surchargée par qdrant.collection-name côté services.
QDRANT_COLLECTION=chunks

# --- Bascule du provider LLM actif : groq | gemini | ollama ---
ACTIVE_LLM_PROVIDER=ollama

# --- Persona de l'espace : URL interne de space-service (appel service-à-service) ---
SPACE_SERVICE_URL=http://localhost:8082

# --- Groq (API compatible OpenAI, cf. chat-service/application.yml) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini AI Studio (chat-service ET docling-worker — vision/transcription, spec v2) ---
# Générer une clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Ollama (fallback local/hors-ligne — profil docker compose "ollama") ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Chat RAG (chat-service) ---
# Seuil de similarité minimal pour qu'un chunk soit injecté dans le prompt
CHAT_SIMILARITY_THRESHOLD=0.7
