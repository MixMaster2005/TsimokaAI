<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>mg.esmia.miage</groupId>
        <artifactId>tsimokaai-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>chat-service</artifactId>
    <packaging>jar</packaging>
    <name>chat-service</name>
    <description>
        Orchestration RAG + historique de conversation.
        ================================ SCAFFOLD VOLONTAIRE ================================
        Entités, endpoints REST, persistance de l'historique, publication d'événements :
        fournis et fonctionnels. L'orchestration RAG elle-même (retrieval Qdrant + prompt
        système = persona + appel LLM avec bascule Groq/Gemini/Ollama) est un TODO explicite
        dans ChatService — c'est le cœur du mémoire à combler.
        =======================================================================================
    </description>

    <dependencies>
        <dependency>
            <groupId>mg.esmia.miage</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Groq expose une API compatible OpenAI -> on pointe le starter OpenAI sur
             son base-url (cf. application.yml, spring.ai.openai.base-url=https://api.groq.com/openai). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- Fallback hors-ligne. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>        </dependency>
        <!-- NB: pas de starter Spring AI officiel unique pour "Gemini AI Studio" au moment
             de la rédaction (Spring AI propose Vertex AI Gemini, différent de la clé API
             AI Studio). A vérifier/choisir entre spring-ai-vertex-ai-gemini-spring-boot-starter
             (GCP) et un appel WebClient manuel vers generativelanguage.googleapis.com selon
             ce qui est réellement disponible à la date du build (non vérifiable ici, hors-ligne
             des repos Maven). -->

        <dependency>
            <groupId>io.qdrant</groupId>
            <artifactId>client</artifactId>
            <version>1.13.0</version>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>chat-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
