<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>mg.esmia.miage</groupId>
        <artifactId>tsimokaai-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>chat-service</artifactId>
    <packaging>jar</packaging>
    <name>chat-service</name>
    <description>
        Orchestration RAG + historique de conversation.
        ================================ SCAFFOLD VOLONTAIRE ================================
        Entités, endpoints REST, persistance de l'historique, publication d'événements :
        fournis et fonctionnels. L'orchestration RAG elle-même (retrieval Qdrant + prompt
        système = persona + appel LLM avec bascule Groq/Gemini/Ollama) est un TODO explicite
        dans ChatService — c'est le cœur du mémoire à combler.
        =======================================================================================
        ÉTAT : retrieval Qdrant (pipeline RAG custom : rewrite + topK 40 + rerank LLM topN 5,
        filtre space_id), persona (space-service), historique via JpaBackedChatMemory
        (MessageChatMemoryAdvisor) et appel LLM (ChatProviderResolver, module ai-common).
    </description>

    <dependencies>
        <dependency>
            <groupId>mg.esmia.miage</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <!-- Noyau partagé IA : bascule Groq/Gemini/Ollama (ChatProviderResolver) +
             starters Spring AI OpenAI/Ollama + resilience4j (transitifs). -->
        <dependency>
            <groupId>mg.esmia.miage</groupId>
            <artifactId>ai-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Base vectorielle : QdrantVectorStore auto-configuré (collection UNIQUE "chunks",
             Option A multi-tenant, filtre space_id au retrieval). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-qdrant</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>chat-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
