<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>mg.esmia.miage</groupId>
        <artifactId>tsimokaai-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ingestion-service</artifactId>
    <packaging>jar</packaging>
    <name>ingestion-service</name>
    <description>
        Upload, extraction, chunking, embedding, stockage vectoriel.
        ================================ SCAFFOLD VOLONTAIRE ================================
        L'infrastructure générique (upload MinIO, entités, statuts, endpoints REST, clients
        MinIO/Qdrant, publication d'événements) est fournie et fonctionnelle.
        Le cœur métier IA — extraction de texte par format, chunking avec chevauchement,
        génération d'embeddings, upsert Qdrant — est un TODO explicite dans
        IngestionPipelineService : c'est le travail à combler pour le mémoire.
        =======================================================================================
    </description>

    <dependencies>
        <dependency>
            <groupId>mg.esmia.miage</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Stockage fichiers (contrat : fichiers dans MinIO uniquement, jamais en BDD) -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.14</version>
        </dependency>

        <!-- Base vectorielle. NB: ChromaDB (alternative retenue dans le CDC) n'a pas de
             client Java officiel mûr -> utiliser son API REST via WebClient si préféré. -->
        <dependency>
            <groupId>io.qdrant</groupId>
            <artifactId>client</artifactId>
            <version>1.13.0</version>
        </dependency>
        <!-- Le client Qdrant déclare grpc en scope `runtime` : il manque au classpath de
             compilation (QdrantConfig utilise QdrantGrpcClient -> io.grpc.ManagedChannel).
             Version alignée sur celle du client Qdrant 1.13.0. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>1.65.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Extraction de texte multi-format (PDF, DOCX, TXT) — TODO d'usage dans
             IngestionPipelineService. Apache Tika couvre tous les formats du MVP en une lib. -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>2.9.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>2.9.2</version>
        </dependency>

        <!-- Spring AI : nécessaire pour l'appel au modèle d'embedding (TODO pipeline).
             ArtifactId 1.0 GA : spring-ai-starter-model-ollama (vérifié contre spring-ai-bom:1.0.0). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ingestion-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
